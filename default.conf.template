server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

   
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets — cache hard
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    
    location /api/user/     { proxy_pass http://${USER_HOST}:8000/; }
    location /api/profile/  { proxy_pass http://${PROFILE_HOST}:8002/; }
    location /api/product/  { proxy_pass http://${PRODUCT_HOST}:8003/; }
    location /api/cart/     { proxy_pass http://${CART_HOST}:8004/; }
    location /api/order/    { proxy_pass http://${ORDER_HOST}:8005/; }
    location /api/payment/  { proxy_pass http://${PAYMENT_HOST}:8006/; }
}